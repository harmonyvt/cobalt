{
    "name": "cobalt-api-worker",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "deploy": "./prepare-git-info.sh && cf deploy --secrets-file \"${COBALT_SECRETS_FILE:-$HOME/.config/cobalt/secrets.json}\"",
        "dry-run": "./prepare-git-info.sh && cf deploy --dry-run --secrets-file \"${COBALT_SECRETS_FILE:-$HOME/.config/cobalt/secrets.json}\"",
        "gen": "node scripts/run-gen.mjs",
        "gen:check": "node scripts/run-gen.mjs --check",
        "widgets": "node scripts/build-widgets.mjs",
        "widgets:check": "node scripts/build-widgets.mjs --check",
        "widgets:dev": "node widgets-dev/serve.mjs",
        "widgets:test": "node widgets-dev/check.mjs",
        "mcp:dev": "node widgets-dev/mcp-dev.mjs",
        "mcp:dev:test": "node widgets-dev/mcp-dev-check.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.135.0",
        "@cloudflare/containers": "^0.3.7",
        "@modelcontextprotocol/ext-apps": "^2.0.4",
        "@modelcontextprotocol/server": "^2.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260929.1",
        "@modelcontextprotocol/client": "^2.4.0",
        "@types/node": "^22.20.4",
        "cf": "1.0.0-beta.5",
        "esbuild": "0.28.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.2",
        "wrangler": "^4.143.0"
    }
}
